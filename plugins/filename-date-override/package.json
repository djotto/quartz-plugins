{
  "name": "@otton/filename-date-override",
  "version": "1.0.0",
  "type": "module",
  "description": "Quartz v5 transformer that derives note dates from filenames and meaningful Git author history.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "filename-date-override",
    "displayName": "FilenameDateOverride",
    "description": "Sets missing dates from filenames and Git author history while excluding date-neutral migration commits.",
    "version": "1.0.0",
    "category": "transformer",
    "defaultOrder": 9,
    "defaultEnabled": true,
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {},
    "optionSchema": {},
    "dependencies": []
  }
}

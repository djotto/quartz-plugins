{
  "name": "@otton/content-index",
  "version": "1.0.0",
  "type": "module",
  "description": "Quartz v5 sitemap, RSS, and configurable JSON content index emitter.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-html": "^9.0.5",
    "preact": "^10.27.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "hast-util-to-html": "^9.0.5",
    "preact": "^10.27.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "content-index",
    "displayName": "Content Index",
    "description": "Generates sitemap, RSS, and contentIndex.json with explicitly configured JSON fields.",
    "version": "1.0.0",
    "category": "emitter",
    "defaultOrder": 50,
    "defaultEnabled": true,
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {},
    "optionSchema": {},
    "dependencies": []
  }
}

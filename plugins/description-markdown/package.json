{
  "name": "@otton/description-markdown",
  "version": "1.0.0",
  "type": "module",
  "description": "Render frontmatter descriptions with the configured Quartz Markdown pipeline.",
  "files": [
    "dist",
    "src",
    "types",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "@types/hast": "^3.0.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "hast-util-to-html": "^9.0.5",
    "mdast-util-to-hast": "^13.2.1",
    "mdast-util-to-string": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "description-markdown",
    "displayName": "Description Markdown",
    "description": "Populates descriptionHtml from frontmatter using configured GFM, OFM, and link transformers.",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "category": "transformer",
    "defaultOrder": 95,
    "defaultEnabled": true,
    "dependencies": [
      "@quartz-community/obsidian-flavored-markdown",
      "@quartz-community/github-flavored-markdown",
      "@quartz-community/crawl-links",
      "@quartz-community/hard-line-breaks",
      "@quartz-community/latex"
    ],
    "defaultOptions": {},
    "optionSchema": {}
  }
}

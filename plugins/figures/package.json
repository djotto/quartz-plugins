{
  "name": "@otton/figures",
  "version": "1.0.0",
  "type": "module",
  "description": "Quartz v5 post-OFM transformer for captions and comparison figures.",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --packages=external --platform=node --format=esm --target=node22 --outfile=dist/index.js",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "sharp": "^0.35.4",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@quartz-community/obsidian-flavored-markdown": "^0.1.2",
    "@quartz-community/types": "^0.3.0",
    "@quartz-community/utils": "^0.1.0",
    "@types/hast": "^3.0.4",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "hast-util-to-html": "^9.0.5",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "figures",
    "displayName": "Figures",
    "description": "Converts legacy colon captions plus {{caption}} and {{compare}} directives into styled, accessible figures.",
    "version": "1.0.0",
    "category": "transformer",
    "defaultOrder": 42,
    "defaultEnabled": false,
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {},
    "optionSchema": {},
    "dependencies": [
      "@quartz-community/obsidian-flavored-markdown"
    ]
  }
}

    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "quartz": {
    "name": "fonts",
    "displayName": "Fonts",
    "category": [
      "transformer",
      "emitter"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 60,
    "defaultEnabled": false,
    "defaultOptions": {
      "useThemeFonts": true,
      "fontOrigin": "googleFonts"
    },
    "optionSchema": {

{
  "name": "@otton/map",
  "version": "1.0.0",
  "type": "module",
  "description": "Quartz v5 post-OFM transformer for the legacy {{map}} GeoJSON directive.",
  "files": [
    "dist",
    "src",
    "README.md",
    "build.mjs"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@quartz-community/types": "^0.3.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@quartz-community/types": "^0.3.0",
    "@types/hast": "^3.0.4",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "hast-util-from-html": "^2.0.3",
    "leaflet": "^1.9.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "map",
    "displayName": "Map",
    "description": "Converts {{map}} GeoJSON directives into responsive interactive maps with points, hulls, alpha shapes, hexbins, heatmaps, search, legends, and postcard popups.",
    "version": "1.0.0",
    "category": "transformer",
    "defaultOrder": 41,
    "defaultEnabled": false,
    "quartzVersion": ">=5.0.0",
    "defaultOptions": {},
    "optionSchema": {
      "cartoBasemapsApiKey": {
        "type": "string"
      }
    },
    "dependencies": [
      "@quartz-community/obsidian-flavored-markdown"
    ]
  }
}
